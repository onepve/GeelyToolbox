<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="吉利工具箱 · 使用指南"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="5dp"
        android:text="1. 安全安装：严禁使用 ADB pm install 直装，所有 APK 下载或传输后，均在工具箱中点击「打开原生文件管理」直接点击安装，彻底避免空调界面白屏。\n2. 飞屏高德 9.5：已注入 5 个 64 位原厂吉利仪表飞屏/分屏库，支持随灯变色与横灯胶囊排列。\n3. 主题防覆写与伪装：工具箱自动生成「防覆写占位锁」阻止系统自动重写；一键将 APK 伪装进 clock.rabbit.xtz 兔子时钟，选择应用并软重启即可生效。\n4. 无线快传与速推：手机扫码即开轻量网页，支持局域网直推外部下载链接与 2MB 分片 APK 高速上传。\n5. 音乐与蓝牙分工：原厂多媒体仅负责酷我/本地USB/蓝牙界面；蓝牙电话与配对由系统独立负责，冻结多媒体完全不影响电话接打。若改用 QQ 音乐，建议配合安装方控切歌助手。"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_dialog_help_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_secondary_bg"
        android:text="我知道了"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>

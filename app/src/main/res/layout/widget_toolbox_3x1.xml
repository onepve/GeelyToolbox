<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶栏：标题、车型徽章与今日油价 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 缤越助手"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_platform_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="[ 缤越COOL · IHU516G ]"
            android:textColor="#60A5FA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_oil_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="92# 油价关注中"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 中部主内容区分栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 第 1 栏：蓄电池电压与动力模式 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="蓄电池实时电压"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_battery_volt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="13.1V"
                android:textColor="#38BDF8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_battery_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="健康良好 · P挡"
                android:textColor="#4ADE80"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 分割线 1 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:background="#334155" />

        <!-- 第 2 栏：五门微缩鸟瞰图示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_doors_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全车门锁"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <!-- 前排两门 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_door_fl"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_door_dot_closed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="前"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_door_fr"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_door_dot_closed" />
            </LinearLayout>

            <!-- 后排两门 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_door_rl"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_door_dot_closed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="后"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_door_rr"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_door_dot_closed" />
            </LinearLayout>

            <!-- 尾门 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="尾"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/widget_door_trunk"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="3dp"
                    android:src="@drawable/widget_door_dot_closed" />
            </LinearLayout>
        </LinearLayout>

        <!-- 分割线 2 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#334155" />

        <!-- 第 3 栏：高频快捷动作 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_btn_360"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="🎥 开启 360 全景"
                android:textColor="#F1F5F9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_btn_engineer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="⚡ 今日暗号"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
